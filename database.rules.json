{
  "rules": {
    "adminConfig": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "userResults": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "activeSessions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
